{
  "name": "deepholdings",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @deepholdings/client",
    "dev:server": "npm run dev --workspace @deepholdings/server",
    "build": "npm run build --workspace @deepholdings/shared && npm run build --workspace @deepholdings/server && npm run build --workspace @deepholdings/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
