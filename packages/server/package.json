{
  "name": "@deepholdings/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "simulate": "tsx tools/simulate.ts",
    "cadence": "tsx tools/cadence.ts"
  },
  "dependencies": {
    "@deepholdings/shared": "*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.11.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
